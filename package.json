{
  "name": "doublemusic",
  "version": "1.4.0",
  "description": "Local music library server with optional external API connections",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "./core-rust/target/release/doublemusic-core",
    "user": "node cli.js",
    "test": "node --test test/*.test.js",
    "start:catalog": "node server.js",
    "test:rust": "cargo test --manifest-path core-rust/Cargo.toml --locked",
    "test:container": "node scripts/test-container.cjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  }
}
