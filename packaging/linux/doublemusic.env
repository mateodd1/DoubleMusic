# Native Linux installation. Use simple shell-compatible KEY=value entries.
DATA_DIR=/var/lib/doublemusic
MUSIC_DIR=/srv/doublemusic/music
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
SOURCES_FILE=/etc/doublemusic/settings.json
SCAN_INTERVAL_SECONDS=300
CACHE_MAX_MB=2048
TRUST_PROXY=false
SECURE_COOKIES=false
ALLOWED_ORIGINS=
