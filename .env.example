MUSIC_DIR=./music
PORT=3000
# Public API origin, without /api/v1 or a trailing slash.
PUBLIC_URL=http://localhost:3000
SCAN_INTERVAL_SECONDS=300
CACHE_MAX_MB=2048
# Enable only behind a trusted proxy that rewrites forwarded headers.
TRUST_PROXY=false

# Optional: JSON with library.enabled (true) and external.enabled (false).
# Mount the file and, if external connections are enabled, their private tokens.
# SOURCES_FILE=/config/sources.json
