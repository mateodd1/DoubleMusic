MUSIC_DIR=./music
PORT=3000
# Origen público de la API, sin /api/v1 ni barra final.
PUBLIC_URL=http://localhost:3000
SCAN_INTERVAL_SECONDS=300
CACHE_MAX_MB=2048
# Activar solo detrás de un proxy de confianza que reescriba las cabeceras.
TRUST_PROXY=false

# Opcional: JSON con library.enabled (true) y external.enabled (false).
# Montar el archivo y, si habilitas conexiones, sus tokens privados.
# SOURCES_FILE=/config/sources.json
